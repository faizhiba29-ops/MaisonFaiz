# ─────────────────────────────────────────────────────────────────
# Copiez ce fichier en `.env` (jamais commité) et remplissez-le.
# Sur Vercel : Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé PUBLIQUE uniquement : « Publishable key » (sb_publishable_…) ou « anon » (eyJ…).
# Ne mettez JAMAIS la clé secrète (sb_secret_… / service_role) : tout ce qui commence
# par VITE_ est lisible par n'importe quel visiteur du site.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Adresse publique du site (aperçus WhatsApp / Instagram)
VITE_SITE_URL=https://www.maisonfaiz.ma
